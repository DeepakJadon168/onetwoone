# Leave this UNSET for local development — Vite's dev-server proxy (vite.config.js)
# already forwards "/api" calls to http://localhost:5000.
#
# When deploying the frontend (e.g. on Vercel), set this to your deployed
# backend's full URL with /api at the end, for example:
# VITE_API_URL=https://your-backend.vercel.app/api
VITE_API_URL=
