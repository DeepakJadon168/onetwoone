# MongoDB connection string (MongoDB Atlas ya local MongoDB dono chalega)
MONGO_URI=mongodb://127.0.0.1:27017/scooty_rental_indore

# JWT secret - koi bhi random lamba string daal do
JWT_SECRET=change_this_to_a_long_random_secret

# Server port
PORT=5000

# Frontend URL - used to build the QR check-in verification link
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (multiple vehicle images / cloud upload) ---
# Free account: https://cloudinary.com -> Dashboard shows these 3 values
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Razorpay (payment integration) ---
# Test mode keys: https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- SMTP email (booking confirmation email with QR attached) ---
# Gmail example: use an "App Password" (not your normal Gmail password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=One To One Rental <your_email@gmail.com>

# --- WhatsApp ---
# The wa.me click-to-chat link always works, no setup needed.
# OPTIONAL: fill these only if you want the SERVER to auto-send WhatsApp
# messages via Twilio's WhatsApp API (paid, needs Meta/Twilio approval):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
